        "*.inc": "cpp",
        "hash_map": "cpp",
        "semaphore": "cpp",
        "armadillo": "cpp",
        "*.main": "cpp",
        "utility": "cpp"
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/.vscode/**": true,
        "**/modules/**": true,
        "**build/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "cSpell.words": [
        "pysfacpp"
    ]
}