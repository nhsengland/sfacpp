{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/local_test.out",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) Debug (CMake)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/sfacpp",
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug C++ (Launch Python)",
            "type": "lldb",  // Uses CodeLLDB
            "request": "launch",
            // Point this to your specific Python executable
            "program": "/opt/homebrew/Cellar/python@3.11/3.11.14_1/Frameworks/Python.framework/Versions/3.11/bin/python3.11", 
            "args": [
                "${file}" // Runs the currently active Python file
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DYLD_INSERT_LIBRARIES": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/lib/clang/17/lib/darwin/libclang_rt.asan_osx_dynamic.dylib",
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "sourceMap": {
                // Map build paths if necessary (usually not needed for local builds)
            }
        },
        {
            "name": "Python C++ Debugger",
            "type": "pythoncpp",
            "request": "launch",
            "pythonLaunchName": "Python: Current File",
            "cppAttachName": "(lldb) Attach",
            "preLaunchTask": "Build & install pysfacpp",
            "internalConsoleOptions": "neverOpen",
            "presentation": {
                "clear": true
            }
        },
        {
            "name": "(lldb) Attach",
            "type": "lldb",  // Requires CodeLLDB extension
            "request": "attach",
            // "program": "${workspaceFolder}/.venv/bin/python3",
            "program": "/opt/homebrew/Cellar/python@3.11/3.11.14_1/Frameworks/Python.framework/Versions/3.11/bin/python3.11",
            "pid": "${command:pickMyProcess}" // or let the composite launch handle it
        },
        {
            "name": "(gdb) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/.venv/bin/python3",
            "MIMode": "lldb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for lldb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python_debug"
        }
    ]
}